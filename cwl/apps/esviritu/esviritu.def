Bootstrap: docker
From: quay.io/biocontainers/esviritu:1.3.4--pyhdfd78af_0

%files
    db/v3.2.4 /opt/esviritu_db/v3.2.4

%post
    R CMD INSTALL $(ls -d /usr/local/lib/python3*/site-packages/EsViritu/dataui_vendored)
    Rscript -e 'stopifnot(requireNamespace("dataui", quietly=TRUE))'

%environment
    export ESVIRITU_DB=/opt/esviritu_db/v3.2.4
    export LC_ALL=C.UTF-8

%labels
    org.opencontainers.image.title EsViritu
    org.opencontainers.image.source https://github.com/cmmr/EsViritu
    esviritu.version 1.3.4
    esviritu.db.version 3.2.4
    esviritu.db.md5 24d85c1ec3cbffff12e921d2f39c91b2
    esviritu.db.source https://zenodo.org/records/17716199

%help
    EsViritu 1.3.4 (bioconda) with reference database v3.2.4 at $ESVIRITU_DB.
    Run: EsViritu -r reads.fastq -s SAMPLE -o OUTDIR -p unpaired
