{
  "_doc": "Contract between the parser (normalizeType -> TypeSchema) and the validator (#273). 'normalize' cases: raw CWL type as written in source (plus SchemaDefRequirement types) -> canonical TypeSchema. 'validate' cases: canonical TypeSchema + JSON value -> valid or not. Canonical form: primitive/unresolved-name = string; union = list; array = {type:array, items}; enum = {type:enum, symbols:[raw]}; record = {type:record, fields:[{name(raw), type}]}; recursion guard = {type:$ref, name}. Canonical maps carry ONLY these keys (name/label/doc/inputBinding dropped; field entries keep only name+type). Map-form record fields become a list sorted by key. Any string that is not a primitive (null boolean int long float double string File Directory Any stdin) is an unresolved named ref and validates as VALID. Named lookup: exact name first, then short name (after last '/' or '#') only if unique.",
  "normalize": [
    {
      "name": "primitive",
      "raw": "string",
      "want": "string"
    },
    {
      "name": "optional shorthand",
      "raw": "string?",
      "want": [
        "null",
        "string"
      ]
    },
    {
      "name": "array shorthand",
      "raw": "File[]",
      "want": {
        "type": "array",
        "items": "File"
      }
    },
    {
      "name": "optional array shorthand",
      "raw": "int[]?",
      "want": [
        "null",
        {
          "type": "array",
          "items": "int"
        }
      ]
    },
    {
      "name": "shorthand inside items",
      "raw": {
        "type": "array",
        "items": "string?"
      },
      "want": {
        "type": "array",
        "items": [
          "null",
          "string"
        ]
      }
    },
    {
      "name": "inline enum, extra keys dropped",
      "raw": {
        "type": "enum",
        "name": "#e",
        "doc": "x",
        "symbols": [
          "a",
          "b"
        ],
        "inputBinding": {
          "position": 1
        }
      },
      "want": {
        "type": "enum",
        "symbols": [
          "a",
          "b"
        ]
      }
    },
    {
      "name": "optional enum with packed symbols kept raw",
      "raw": [
        "null",
        {
          "type": "enum",
          "symbols": [
            "#chunk/fixed",
            "#chunk/semantic"
          ]
        }
      ],
      "want": [
        "null",
        {
          "type": "enum",
          "symbols": [
            "#chunk/fixed",
            "#chunk/semantic"
          ]
        }
      ]
    },
    {
      "name": "non-null union kept",
      "raw": [
        "int",
        "string"
      ],
      "want": [
        "int",
        "string"
      ]
    },
    {
      "name": "File or File array union",
      "raw": [
        "File",
        "File[]"
      ],
      "want": [
        "File",
        {
          "type": "array",
          "items": "File"
        }
      ]
    },
    {
      "name": "record list-form fields",
      "raw": {
        "type": "record",
        "name": "r",
        "fields": [
          {
            "name": "a",
            "type": "string?",
            "doc": "d"
          },
          {
            "name": "b",
            "type": "int"
          }
        ]
      },
      "want": {
        "type": "record",
        "fields": [
          {
            "name": "a",
            "type": [
              "null",
              "string"
            ]
          },
          {
            "name": "b",
            "type": "int"
          }
        ]
      }
    },
    {
      "name": "record map-form fields sorted, scalar and map values",
      "raw": {
        "type": "record",
        "fields": {
          "z": "string?",
          "a": {
            "type": "int",
            "doc": "d"
          }
        }
      },
      "want": {
        "type": "record",
        "fields": [
          {
            "name": "a",
            "type": "int"
          },
          {
            "name": "z",
            "type": [
              "null",
              "string"
            ]
          }
        ]
      }
    },
    {
      "name": "record map-form field whose value is a union list",
      "raw": {
        "type": "record",
        "fields": {
          "species": [
            {
              "type": "enum",
              "symbols": [
                "homo_sapiens",
                "mus_musculus"
              ]
            },
            "null"
          ]
        }
      },
      "want": {
        "type": "record",
        "fields": [
          {
            "name": "species",
            "type": [
              {
                "type": "enum",
                "symbols": [
                  "homo_sapiens",
                  "mus_musculus"
                ]
              },
              "null"
            ]
          }
        ]
      }
    },
    {
      "name": "named enum inlined (exact)",
      "raw": "#MyEnum",
      "schemaDefs": [
        {
          "name": "#MyEnum",
          "type": "enum",
          "symbols": [
            "x",
            "y"
          ]
        }
      ],
      "want": {
        "type": "enum",
        "symbols": [
          "x",
          "y"
        ]
      }
    },
    {
      "name": "named record inlined by unique short name, packed field name kept raw",
      "raw": "#capture_kit.yml/capture_kit",
      "schemaDefs": [
        {
          "name": "capture_kit",
          "type": "record",
          "fields": [
            {
              "name": "#capture_kit.yml/capture_kit/bait",
              "type": "string"
            }
          ]
        }
      ],
      "want": {
        "type": "record",
        "fields": [
          {
            "name": "#capture_kit.yml/capture_kit/bait",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "bare named ref resolved by short name",
      "raw": {
        "type": "array",
        "items": "readgroup_meta"
      },
      "schemaDefs": [
        {
          "name": "schemadef-types.yml#readgroup_meta",
          "type": "record",
          "fields": [
            {
              "name": "rg",
              "type": "string"
            }
          ]
        }
      ],
      "want": {
        "type": "array",
        "items": {
          "type": "record",
          "fields": [
            {
              "name": "rg",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "ambiguous short name stays unresolved",
      "raw": "Rec",
      "schemaDefs": [
        {
          "name": "a.yml#Rec",
          "type": "enum",
          "symbols": [
            "p"
          ]
        },
        {
          "name": "b.yml#Rec",
          "type": "enum",
          "symbols": [
            "q"
          ]
        }
      ],
      "want": "Rec"
    },
    {
      "name": "unknown named ref stays a string",
      "raw": "#Nowhere",
      "want": "#Nowhere"
    },
    {
      "name": "recursive record gets $ref guard",
      "raw": "#Node",
      "schemaDefs": [
        {
          "name": "#Node",
          "type": "record",
          "fields": [
            {
              "name": "children",
              "type": {
                "type": "array",
                "items": "#Node"
              }
            }
          ]
        }
      ],
      "want": {
        "type": "record",
        "fields": [
          {
            "name": "children",
            "type": {
              "type": "array",
              "items": {
                "type": "$ref",
                "name": "#Node"
              }
            }
          }
        ]
      }
    },
    {
      "name": "stdin primitive",
      "raw": "stdin",
      "want": "stdin"
    },
    {
      "name": "record field with default becomes nullable (BV-BRC generated tools)",
      "raw": {
        "type": "record",
        "fields": [
          {
            "name": "interleaved",
            "type": "boolean",
            "default": false
          },
          {
            "name": "read1",
            "type": "File"
          }
        ]
      },
      "want": {
        "type": "record",
        "fields": [
          {
            "name": "interleaved",
            "type": [
              "null",
              "boolean"
            ]
          },
          {
            "name": "read1",
            "type": "File"
          }
        ]
      }
    },
    {
      "name": "map-form record field with default becomes nullable",
      "raw": {
        "type": "record",
        "fields": {
          "platform": {
            "type": "string",
            "default": "infer"
          },
          "x": "int"
        }
      },
      "want": {
        "type": "record",
        "fields": [
          {
            "name": "platform",
            "type": [
              "null",
              "string"
            ]
          },
          {
            "name": "x",
            "type": "int"
          }
        ]
      }
    }
  ],
  "validate": [
    {
      "name": "string ok",
      "schema": "string",
      "value": "x",
      "valid": true
    },
    {
      "name": "string rejects number",
      "schema": "string",
      "value": 5,
      "valid": false,
      "errContains": "string"
    },
    {
      "name": "boolean ok",
      "schema": "boolean",
      "value": true,
      "valid": true
    },
    {
      "name": "boolean rejects string true",
      "schema": "boolean",
      "value": "true",
      "valid": false
    },
    {
      "name": "int from json float64 integral",
      "schema": "int",
      "value": 42,
      "valid": true
    },
    {
      "name": "int rejects fraction",
      "schema": "int",
      "value": 4.5,
      "valid": false
    },
    {
      "name": "int rejects numeric string",
      "schema": "int",
      "value": "42",
      "valid": false
    },
    {
      "name": "int rejects out of int32 range",
      "schema": "int",
      "value": 4147483647,
      "valid": false
    },
    {
      "name": "long accepts beyond int32",
      "schema": "long",
      "value": 4147483647,
      "valid": true
    },
    {
      "name": "float accepts integer",
      "schema": "float",
      "value": 1230000,
      "valid": true
    },
    {
      "name": "double accepts huge",
      "schema": "double",
      "value": 1e+42,
      "valid": true
    },
    {
      "name": "null only accepts null",
      "schema": "null",
      "value": 0,
      "valid": false
    },
    {
      "name": "optional accepts null",
      "schema": [
        "null",
        "string"
      ],
      "value": null,
      "valid": true
    },
    {
      "name": "enum ok",
      "schema": {
        "type": "enum",
        "symbols": [
          "fixed",
          "semantic"
        ]
      },
      "value": "semantic",
      "valid": true
    },
    {
      "name": "enum rejects unknown, lists symbols",
      "schema": {
        "type": "enum",
        "symbols": [
          "fixed",
          "semantic"
        ]
      },
      "value": "semantic_pooled_typo",
      "valid": false,
      "errContains": "fixed, semantic"
    },
    {
      "name": "enum packed symbols match short value",
      "schema": {
        "type": "enum",
        "symbols": [
          "#chunk/fixed",
          "file.cwl#chunk_method/semantic"
        ]
      },
      "value": "semantic",
      "valid": true
    },
    {
      "name": "enum rejects non-string",
      "schema": {
        "type": "enum",
        "symbols": [
          "1",
          "2"
        ]
      },
      "value": 1,
      "valid": false
    },
    {
      "name": "array of enum ok",
      "schema": {
        "type": "array",
        "items": {
          "type": "enum",
          "symbols": [
            "a",
            "b"
          ]
        }
      },
      "value": [
        "a",
        "b",
        "a"
      ],
      "valid": true
    },
    {
      "name": "array item error has index path",
      "schema": {
        "type": "array",
        "items": "int"
      },
      "value": [
        1,
        "two",
        3
      ],
      "valid": false,
      "errPath": "[1]"
    },
    {
      "name": "array rejects scalar",
      "schema": {
        "type": "array",
        "items": "string"
      },
      "value": "a",
      "valid": false
    },
    {
      "name": "record ok, extra keys ignored",
      "schema": {
        "type": "record",
        "fields": [
          {
            "name": "a",
            "type": "string"
          }
        ]
      },
      "value": {
        "a": "x",
        "maxSeedHits": 3
      },
      "valid": true
    },
    {
      "name": "record field matched by short name",
      "schema": {
        "type": "record",
        "fields": [
          {
            "name": "#capture_kit.yml/capture_kit/bait",
            "type": "string"
          }
        ]
      },
      "value": {
        "bait": "abait"
      },
      "valid": true
    },
    {
      "name": "record missing required field",
      "schema": {
        "type": "record",
        "fields": [
          {
            "name": "a",
            "type": "string"
          }
        ]
      },
      "value": {},
      "valid": false,
      "errPath": ".a"
    },
    {
      "name": "record missing nullable field ok",
      "schema": {
        "type": "record",
        "fields": [
          {
            "name": "a",
            "type": [
              "null",
              "string"
            ]
          }
        ]
      },
      "value": {},
      "valid": true
    },
    {
      "name": "union any member",
      "schema": [
        "int",
        "string"
      ],
      "value": "x",
      "valid": true
    },
    {
      "name": "union no member",
      "schema": [
        "int",
        "string"
      ],
      "value": true,
      "valid": false
    },
    {
      "name": "union with unresolved member is valid",
      "schema": [
        "#Map1",
        "int"
      ],
      "value": {
        "algo": "map1"
      },
      "valid": true
    },
    {
      "name": "File or File array accepts list",
      "schema": [
        "File",
        {
          "type": "array",
          "items": "File"
        }
      ],
      "value": [
        {
          "class": "File",
          "location": "a.txt"
        }
      ],
      "valid": true
    },
    {
      "name": "File without class but with location is valid (engine normalizes it)",
      "schema": "File",
      "value": {
        "location": "a.txt"
      },
      "valid": true
    },
    {
      "name": "File bare non-empty string is valid (engine normalizes it)",
      "schema": "File",
      "value": "/user@bvbrc/home/a.txt",
      "valid": true
    },
    {
      "name": "File map without class, location, path, or contents is invalid",
      "schema": "File",
      "value": {
        "format": "text/plain"
      },
      "valid": false
    },
    {
      "name": "File empty string is invalid",
      "schema": "File",
      "value": "",
      "valid": false
    },
    {
      "name": "File rejects non-string non-map value",
      "schema": "File",
      "value": 5,
      "valid": false
    },
    {
      "name": "File without class but with path is valid (engine normalizes it)",
      "schema": "File",
      "value": {
        "path": "/tmp/a.txt"
      },
      "valid": true
    },
    {
      "name": "File without class but with contents is valid (literal file)",
      "schema": "File",
      "value": {
        "contents": "hello"
      },
      "valid": true
    },
    {
      "name": "Directory without class but with location is valid (engine normalizes it)",
      "schema": "Directory",
      "value": {
        "location": "ws:///u@bvbrc/home/d"
      },
      "valid": true
    },
    {
      "name": "Directory bare non-empty string is valid (engine normalizes it)",
      "schema": "Directory",
      "value": "/u@bvbrc/home/d",
      "valid": true
    },
    {
      "name": "Directory map without class/location/path is invalid (contents does not count)",
      "schema": "Directory",
      "value": {
        "contents": "hello"
      },
      "valid": false
    },
    {
      "name": "Directory class ok",
      "schema": "Directory",
      "value": {
        "class": "Directory",
        "location": "ws:///u@bvbrc/home/d"
      },
      "valid": true
    },
    {
      "name": "File class mismatch",
      "schema": "Directory",
      "value": {
        "class": "File",
        "location": "a"
      },
      "valid": false
    },
    {
      "name": "Any accepts anything non-null",
      "schema": "Any",
      "value": {
        "x": [
          1
        ]
      },
      "valid": true
    },
    {
      "name": "unresolved named ref valid",
      "schema": "#Nowhere",
      "value": 12,
      "valid": true
    },
    {
      "name": "$ref valid",
      "schema": {
        "type": "$ref",
        "name": "#Node"
      },
      "value": "anything",
      "valid": true
    },
    {
      "name": "stdin behaves as File",
      "schema": "stdin",
      "value": {
        "class": "File",
        "location": "in.txt"
      },
      "valid": true
    },
    {
      "name": "record omitting a defaulted (nullable) field ok",
      "schema": {
        "type": "record",
        "fields": [
          {
            "name": "interleaved",
            "type": [
              "null",
              "boolean"
            ]
          },
          {
            "name": "read1",
            "type": "File"
          }
        ]
      },
      "value": {
        "read1": {
          "class": "File",
          "location": "ws:///u@bvbrc/home/r1.fq"
        }
      },
      "valid": true
    }
  ],
  "params": [
    {
      "name": "null with default skipped (Any)",
      "schema": "Any",
      "hasDefault": true,
      "present": true,
      "value": null,
      "valid": true
    },
    {
      "name": "null with default skipped (enum)",
      "schema": {
        "type": "enum",
        "symbols": [
          "a"
        ]
      },
      "hasDefault": true,
      "present": true,
      "value": null,
      "valid": true
    },
    {
      "name": "missing with default ok",
      "schema": "int",
      "hasDefault": true,
      "present": false,
      "valid": true
    },
    {
      "name": "missing required",
      "schema": "int",
      "hasDefault": false,
      "present": false,
      "checkMissing": true,
      "valid": false
    },
    {
      "name": "null for required without default",
      "schema": "string",
      "hasDefault": false,
      "present": true,
      "value": null,
      "checkMissing": true,
      "valid": false
    },
    {
      "name": "missing optional ok",
      "schema": [
        "null",
        "int"
      ],
      "hasDefault": false,
      "present": false,
      "valid": true
    },
    {
      "name": "non-null union is required",
      "schema": [
        "int",
        "string"
      ],
      "hasDefault": false,
      "present": false,
      "checkMissing": true,
      "valid": false
    },
    {
      "name": "missing required not reported by default (CheckMissing=false)",
      "schema": "int",
      "hasDefault": false,
      "present": false,
      "valid": true
    },
    {
      "name": "nil schema skipped",
      "schema": null,
      "hasDefault": false,
      "present": true,
      "value": "whatever",
      "valid": true
    },
    {
      "name": "secret placeholder skipped",
      "schema": "int",
      "hasDefault": false,
      "present": true,
      "value": "<secret>",
      "secret": true,
      "valid": true
    },
    {
      "name": "secret value never echoed",
      "schema": {
        "type": "enum",
        "symbols": [
          "a"
        ]
      },
      "hasDefault": false,
      "present": true,
      "value": "hunter2-super-secret",
      "secret": true,
      "valid": false,
      "errNotContains": "hunter2"
    }
  ]
}